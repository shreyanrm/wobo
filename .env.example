# Wobo — environment template. Copy to .env.local and fill.
# NEVER commit .env.local. This repo is public.

# --- Core ---
ENV=dev                                  # dev | stg | prod
DEV_AUTH=true                            # web: dev-mock user, no login. GATEWAY: this alone opens the
                                         # X-Wobo-Dev-Subject seam — it accepts ANY asserted identity.
                                         # NEVER on a host: ENV=prod refuses to boot with it set.
CONSENT_TIER_DEFAULT=un_elevated         # un_elevated | elevated (dev default safe = un_elevated)
MOCK_SUBJECT_ID=00000000-0000-7000-8000-000000000001   # fixed opaque dev subject (uuid v7 shape)

# --- Provider seams (mock-first; flip per seam to go live) ---
LLM_MODE=mock                            # mock | live
CONTENT_MODE=seed                        # seed | live
PERSIST_MODE=local                       # local | live (live => Supabase learner_state/threads/outbox; localStorage stays the offline cache)
WHATSAPP_MODE=mock                       # mock | live
EMAIL_MODE=console                       # console | live
PUSH_MODE=console                        # console | live
PAYMENT_MODE=mock                        # mock | live

# --- Supabase (Learner operational plane = project "MSR Build") ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx     # publishable/anon key (client-safe)
SUPABASE_SERVICE_ROLE_KEY=               # SECRET, server-only. The gateway's consent/plan lookup
                                         # uses it; without it every learner reads as un-elevated + free
SUPABASE_PROJECT_REF=YOUR-PROJECT
SUPABASE_DEV_JWT=                        # dev-only: pre-minted JWT (sub = MOCK_SUBJECT_ID, role authenticated) so RLS attributes dev writes; never commit
# Web PWA (Vite) mirrors live in apps/web-pwa/.env.example — see that file for the VITE_ contract.

# --- Track 1 LLM providers (used only when LLM_MODE=live) ---
ANTHROPIC_API_KEY=                       # primary: Wobo, generation, grading
OPENAI_API_KEY=                          # per-capability routing + second-model cross-check
GOOGLE_AI_API_KEY=                       # Gemini: voice / speech-to-speech / STT / TTS

# --- Brand-neutral config (gateway). NON-SECRET. The domain swap is ONE change: set these
# --- on the gateway host and VITE_APP_NAME / VITE_APP_URL on the web host. No user-facing
# --- string, sender address, or allowed origin is hardcoded in service code any more.
APP_NAME=Wobo                              # product name in prompts, emails, page titles
APP_URL=https://wobo.invalid               # canonical web origin; the CORS allow-list entry AND the base of every email link.
                                           # The default is the RFC 2606 reserved name: no hostname is compiled in.
APP_PREVIEW_ORIGIN_REGEX=                  # optional: CORS regex for our own preview deploys.
                                           # Blank => the built-in Vercel preview pattern.
EMAIL_FROM=Wobo <hello@heywobo.com>        # RFC 5322 sender; must be a verified sending domain
EMAIL_REPLY_TO=support@heywobo.com         # reply-to on every send; the one mailbox a person reads
EMAIL_UNSUBSCRIBE_URL=                     # blank => the gateway's own stop route (MAIL_STOP_URL);
                                           # the list-wide fallback when a send has no per-recipient
                                           # link. Live sends without a signed link are held.
MAIL_TOKEN_SECRET=                         # SECRET. Signs the one-click stop token; blank =>
                                           # derived from SUPABASE_JWT_SECRET under a fixed label
MAIL_STOP_URL=                             # blank => GATEWAY_URL/v1/mail/stop
MAIL_QUIET_HOURS=                          # blank => the calendar's 21:00-08:00, family-local
MAIL_CONFIRMED_FESTIVALS=                  # OWNER ACTION on the day: the moon-dated festivals
                                           # confirmed for a date, "eid-al-fitr=2026-03-21,
                                           # eid-al-adha=2026-05-27". Nothing else schedules them.
MAIL_PREFERENCES_STORE=                    # memory => never touch the project (tests, local)
PARENT_LINKS_STORE=                        # memory => never touch the project (tests, local)
SUBSCRIPTIONS_STORE=                       # memory => never touch the project (tests, local).
                                           # The plan record behind Settings, Your plan, Cancel
                                           # (migration 0014) AND the billing ledger (0023). No key
                                           # of its own: it reads and writes with
                                           # SUPABASE_SERVICE_ROLE_KEY, never a client's

# --- Payments (gateway). All three or payments are OFF: checkout answers 503 payments_off, the
# --- webhook is refused, and /healthz says payments: off. The key id reaches the browser (it is
# --- public); the other two never leave the host. Owner supplies them; nothing is compiled in.
RAZORPAY_KEY_ID=                           # non-secret. rzp_test_... until the account goes live
RAZORPAY_KEY_SECRET=                       # SECRET. Basic auth for the provider's API
RAZORPAY_WEBHOOK_SECRET=                   # SECRET. Set the SAME value on the webhook in the
                                           # provider dashboard, pointed at
                                           # GATEWAY_URL/v1/billing/razorpay/webhook. Then run
                                           # `uv run python -m wobo_gateway.billing.plans` once
                                           # to create the four plans and record their ids.
PARENT_INVITE_DAYS=                        # blank => 14: how long a parent's invite link works;
                                           # the token is single-use whatever the window, and an
                                           # unanswered invite reads as expired on the You screen
PARENT_INVITES_PER_DAY=                    # blank => 3: invites one learner may send in a day, every
                                           # row counted whatever became of it; the same address
                                           # is never written to twice in a day
WOBO_HOSPITALITY_CONTENT=                  # blank => content/hospitality in the checkout
EMAIL_POSTAL_ADDRESS=                      # optional override; the company address ships by default and is required on
                                           # commercial mail. Blank renders a loud placeholder.

# --- Identity verification (gateway). ONE of the two must be set when ENV=prod, or boot fails.
SUPABASE_JWT_SECRET=                       # SECRET. HS256 projects: the project's JWT secret
SUPABASE_JWKS_URL=                         # non-secret. RS256/ES256 projects; blank => derived
                                           # from SUPABASE_URL (/auth/v1/.well-known/jwks.json)
SUPABASE_JWT_AUD=authenticated             # non-secret; the audience claim the gateway requires
# Consent lookups (server-side ONLY, never in a client bundle). The tier and plan are read from
# learner.profiles_cache keyed by subject_id — the defaults below match infra/supabase/migrations.
SUPABASE_CONSENT_SCHEMA=learner
SUPABASE_CONSENT_TABLE=profiles_cache
SUPABASE_CONSENT_ID_COLUMN=subject_id

# --- Internal service URLs ---
API_URL=http://localhost:8080
GATEWAY_URL=http://localhost:8081
VERIFIER_URL=http://localhost:8082

# --- Internal key convention: wobo.<app>.<env>.<purpose> ---
WOBO_GATEWAY_KEY=wobo.learner.dev.gateway
INTERNAL_EMAIL_KEY=wobo.learner.dev.email  # gates POST /v1/email/send via X-Wobo-Internal
# --- Transactional email (Resend); EMAIL_MODE=console logs the render, =live sends ---
RESEND_API_KEY=                            # server-only; never commit

# --- Gateway limits (the brain owns every number; the client holds none) ---
RATE_LIMIT_PER_MINUTE=60                 # per verified subject, on spend-bearing routes
UNAUTH_RATE_LIMIT_PER_MINUTE=15          # per address, for callers with no verified identity
MAX_REQUEST_BYTES=262144                 # a context packet, not a file
TRUST_PROXY=                             # =1 only behind OUR proxy: then the LAST X-Forwarded-For hop
FREE_DAILY_TURNS=40                      # the free plan's daily turn allowance
FREE_DAILY_GENERATIONS=8                 # ...and its daily generation allowance
ANON_DAILY_TURNS=6                       # anonymous learners are metered per device address
ANON_DAILY_GENERATIONS=1
PLUS_DAILY_TURNS=400                     # the plan read from learner.profiles_cache.plan
PLUS_DAILY_GENERATIONS=60
VOICE_MAX_RELAYS_PER_LEARNER=2           # one learner can never hold the platform's whole voice
VOICE_MAX_TTS_PER_LEARNER=2
VOICE_MAX_RELAYS=24
VOICE_MAX_TTS=24
# --- Ask Wobo, the public site's box (SITE.md §2): open, grounded on the help centre, tiny ---
ASK_HOURLY_PER_CLIENT=5                  # grounded answers per browser (hashed address + agent) an hour
ASK_DAILY_PER_CLIENT=20                  # ...and a day; the honest line is never counted
ASK_DAILY_GLOBAL=2000                    # model calls the whole door may make in a day; cache hits are free
ASK_MAX_QUESTION_CHARS=300               # longer is refused kindly, never truncated silently
ASK_HELP_EMAIL=help@heywobo.com          # the person in the honest line
WOBO_HELP_CONTENT=                       # blank => docs/copy in the checkout; the image sets it

# --- The operator console's door (services/gateway admin_auth.py, migration 0015) -------------
# WHO IS AN ADMIN IS NOT SET HERE, and there is deliberately no variable that would set it. Admin
# access is a row in ops.admins, written with the service role, and the first row is one INSERT the
# owner runs by hand — the template is at the foot of migration 0015. A list of addresses in the
# environment would be an authorisation editable by anyone who can reach the deploy dashboard,
# with no history and no way to say what a person may DO.
#
# WHAT THE OWNER MUST SWITCH ON BEFORE THE CONSOLE IS USED IN PROD: a TOTP factor, in Supabase
# (Authentication -> Multi-factor), for every account in ops.admins. Until an account has one, its
# access tokens carry aal1 and the console refuses to open a session for it. This is not
# overridable in prod: ADMIN_REQUIRE_MFA=0 with ENV=prod refuses to boot.
ADMIN_STORE=                             # blank => the project; `memory` is local-only, refused in prod
ADMIN_REQUIRE_MFA=1                      # second factor (Supabase aal2). Ignored in prod, where it is always on
ADMIN_SESSION_TTL_S=1800                 # a console session is thirty minutes and does not refresh
ADMIN_REAUTH_WINDOW_S=300                # how long a step-up authorises writes for
ADMIN_REAUTH_TOKEN_MAX_AGE_S=120         # how fresh the re-authenticated token has to be
ADMIN_LOGIN_LIMIT_PER_MINUTE=5           # the login path, per account AND per address
ADMIN_RATE_LIMIT_PER_MINUTE=60           # every other admin request, per admin

# --- Cache / queue (mock-first: blank => in-memory) ---
REDIS_URL=

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
