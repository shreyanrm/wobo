{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "generated by wobo_gateway.plexus.blueprint_spec — do not edit by hand",
  "$defs": {
    "Blueprint": {
      "additionalProperties": false,
      "description": "``create.blueprint`` output: one chapter's pool, keyed node x board x class x version.",
      "properties": {
        "node": {
          "minLength": 1,
          "title": "Node",
          "type": "string"
        },
        "chapter": {
          "minLength": 1,
          "title": "Chapter",
          "type": "string"
        },
        "board": {
          "minLength": 1,
          "title": "Board",
          "type": "string"
        },
        "grade": {
          "minLength": 1,
          "title": "Grade",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "contentVersion": {
          "minLength": 1,
          "title": "Contentversion",
          "type": "string"
        },
        "thread": {
          "minLength": 1,
          "title": "Thread",
          "type": "string"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/BlueprintTopic"
          },
          "minItems": 1,
          "title": "Topics",
          "type": "array"
        },
        "ideas": {
          "items": {
            "$ref": "#/$defs/BlueprintIdea"
          },
          "minItems": 1,
          "title": "Ideas",
          "type": "array"
        },
        "misconceptions": {
          "items": {
            "$ref": "#/$defs/BlueprintMisconception"
          },
          "minItems": 1,
          "title": "Misconceptions",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/BlueprintAssumption"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/BlueprintModule"
          },
          "minItems": 1,
          "title": "Modules",
          "type": "array"
        },
        "flow": {
          "$ref": "#/$defs/BlueprintFlow"
        }
      },
      "required": [
        "node",
        "chapter",
        "board",
        "grade",
        "subject",
        "contentVersion",
        "thread",
        "topics",
        "ideas",
        "misconceptions",
        "modules",
        "flow"
      ],
      "title": "Blueprint",
      "type": "object"
    },
    "BlueprintAssumption": {
      "additionalProperties": false,
      "description": "Something the chapter assumes and the board does not re-teach.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "what": {
          "minLength": 1,
          "title": "What",
          "type": "string"
        },
        "fromChapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fromchapter"
        }
      },
      "required": [
        "id",
        "what"
      ],
      "title": "BlueprintAssumption",
      "type": "object"
    },
    "BlueprintFlow": {
      "additionalProperties": false,
      "description": "The order and why, where the side doors and the boss go, where a skip is allowed.",
      "properties": {
        "order": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Order",
          "type": "array"
        },
        "why": {
          "minLength": 1,
          "title": "Why",
          "type": "string"
        },
        "sideDoors": {
          "items": {
            "$ref": "#/$defs/BlueprintSideDoor"
          },
          "title": "Sidedoors",
          "type": "array"
        },
        "boss": {
          "minLength": 1,
          "title": "Boss",
          "type": "string"
        },
        "bossProves": {
          "minLength": 1,
          "title": "Bossproves",
          "type": "string"
        },
        "skippable": {
          "items": {
            "type": "string"
          },
          "title": "Skippable",
          "type": "array"
        },
        "neverSkip": {
          "items": {
            "type": "string"
          },
          "title": "Neverskip",
          "type": "array"
        },
        "stuck": {
          "items": {
            "$ref": "#/$defs/BlueprintStuckRoute"
          },
          "title": "Stuck",
          "type": "array"
        }
      },
      "required": [
        "order",
        "why",
        "boss",
        "bossProves"
      ],
      "title": "BlueprintFlow",
      "type": "object"
    },
    "BlueprintIdea": {
      "additionalProperties": false,
      "description": "One idea a topic is held by. Mastery is evidence these are held, never a module count.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "what": {
          "minLength": 1,
          "title": "What",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "id",
        "what",
        "topics"
      ],
      "title": "BlueprintIdea",
      "type": "object"
    },
    "BlueprintMisconception": {
      "additionalProperties": false,
      "description": "A wrong idea the topic is known to produce. Mastery is evidence it is gone.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "what": {
          "minLength": 1,
          "title": "What",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "id",
        "what",
        "topics"
      ],
      "title": "BlueprintMisconception",
      "type": "object"
    },
    "BlueprintModule": {
      "additionalProperties": false,
      "description": "One module of the chapter's pool: one idea, one mechanic, one sitting.\n\nEvery field here exists so the planner can choose a group WITHOUT reading the content\n(docs/LEARNING-MODEL.md section 5, last bullet).",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "aim": {
          "minLength": 1,
          "title": "Aim",
          "type": "string"
        },
        "kind": {
          "enum": [
            "reading",
            "worked",
            "simulation",
            "film",
            "items",
            "game",
            "boss"
          ],
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "enum": [
            "way_in",
            "check",
            "repair",
            "stretch",
            "prerequisite",
            "side_door",
            "boss"
          ],
          "title": "Role",
          "type": "string"
        },
        "serves": {
          "items": {
            "type": "string"
          },
          "title": "Serves",
          "type": "array"
        },
        "teaches": {
          "items": {
            "type": "string"
          },
          "title": "Teaches",
          "type": "array"
        },
        "cores": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Cores",
          "type": "array"
        },
        "repairs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repairs"
        },
        "assumes": {
          "items": {
            "type": "string"
          },
          "title": "Assumes",
          "type": "array"
        },
        "minutes": {
          "maximum": 240,
          "minimum": 1,
          "title": "Minutes",
          "type": "integer"
        },
        "mechanics": {
          "items": {
            "$ref": "#/$defs/MechanicCandidate"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Mechanics",
          "type": "array"
        }
      },
      "required": [
        "id",
        "aim",
        "kind",
        "role",
        "cores",
        "minutes",
        "mechanics"
      ],
      "title": "BlueprintModule",
      "type": "object"
    },
    "BlueprintSideDoor": {
      "additionalProperties": false,
      "description": "A bonus level off the climb: optional, mid-chapter, never in the path, never a nag.",
      "properties": {
        "after": {
          "minLength": 1,
          "title": "After",
          "type": "string"
        },
        "module": {
          "minLength": 1,
          "title": "Module",
          "type": "string"
        },
        "rehearses": {
          "minLength": 1,
          "title": "Rehearses",
          "type": "string"
        }
      },
      "required": [
        "after",
        "module",
        "rehearses"
      ],
      "title": "BlueprintSideDoor",
      "type": "object"
    },
    "BlueprintStuckRoute": {
      "additionalProperties": false,
      "description": "What a stuck learner is shown INSTEAD. Never the same module said louder.",
      "properties": {
        "module": {
          "minLength": 1,
          "title": "Module",
          "type": "string"
        },
        "instead": {
          "minLength": 1,
          "title": "Instead",
          "type": "string"
        },
        "why": {
          "minLength": 1,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "module",
        "instead",
        "why"
      ],
      "title": "BlueprintStuckRoute",
      "type": "object"
    },
    "BlueprintTopic": {
      "additionalProperties": false,
      "description": "A topic of the BOARD's own syllabus: what must be learned. Never ours, never invented.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "BlueprintTopic",
      "type": "object"
    },
    "MechanicCandidate": {
      "additionalProperties": false,
      "description": "One candidate interaction for a module: a composition of primitives, never code.\n\nTwo or three of these ride on every module, so the ninety-day rotation of\ndocs/CONTENT-INTERACTION.md section 3 is a pick from what is already stored and never a second\nbill on the create tier. ``wrongMoveTeaches`` is the judge's first question: a wrong move must\nteach something about the IDEA, not about the game.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "primitives": {
          "items": {
            "enum": [
              "branch",
              "drag",
              "drop",
              "mark",
              "match",
              "score",
              "sequence",
              "slide",
              "sort",
              "tap",
              "timer",
              "reveal"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Primitives",
          "type": "array"
        },
        "moves": {
          "minLength": 1,
          "title": "Moves",
          "type": "string"
        },
        "responds": {
          "minLength": 1,
          "title": "Responds",
          "type": "string"
        },
        "wrongMoveTeaches": {
          "minLength": 1,
          "title": "Wrongmoveteaches",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "primitives",
        "moves",
        "responds",
        "wrongMoveTeaches"
      ],
      "title": "MechanicCandidate",
      "type": "object"
    }
  }
}
