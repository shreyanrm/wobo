{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `@playwright/test` and `bun-types` are here so the two test directories type-check under the
    // one command CI runs — a broken spec must fail the build, not sit unchecked until someone
    // runs Playwright by hand.
    "types": ["vite/client", "bun", "@playwright/test"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    // Those same URLs carry the `.ts` extension Vite serves them under.
    "allowImportingTsExtensions": true,
    // The e2e specs reach into the running app through Vite's own module URLs (`/src/…`), which is
    // the only way to drive the real client inside the page. Map them so those imports type-check
    // here rather than only at runtime.
    "baseUrl": ".",
    "paths": {
      "/src/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "test",
    "tests",
    "vite.config.ts",
    "vite.admin.config.ts",
    "playwright.config.ts"
  ]
}
