{
  "name": "@wobo/web-pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run landing:boards && bun run site:content && bun run sitemap && tsc --noEmit && vite build",
    "landing:boards": "bun run scripts/landing-boards.ts",
    "sitemap": "bun run scripts/sitemap.ts",
    "site:content": "bun run scripts/site-content.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts src",
    "test:e2e": "playwright test",
    "test:e2e:plan": "playwright test --config tests-plan/config.ts",
    "test:x-browser": "playwright test --config tests/x-browser.config.ts",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "3dmol": "^2.5.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@react-three/fiber": "^9.6.1",
    "@wobo/config": "workspace:*",
    "@wobo/contracts": "workspace:*",
    "@wobo/motion": "workspace:*",
    "@wobo/sdk": "workspace:*",
    "@wobo/wobo": "workspace:*",
    "codemirror": "^6.0.2",
    "d3-geo": "^3.1.1",
    "framer-motion": "^11.11.0",
    "gsap": "3.12.5",
    "lenis": "1.1.18",
    "mafs": "^0.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/bun": "latest",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  }
}
