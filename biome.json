{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!docs",
      "!**/schemas",
      "!**/_bundle.json",
      "!**/*.workflow.js",
      "!design/prototypes",
      "!content/curriculum/**/*.json",
      "!apps/web-pwa/src/screens/syllabus/syllabus.json",
      "!content/hospitality/**/*.json",
      "!tools/progress/progress-*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  }
}
