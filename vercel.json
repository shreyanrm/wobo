{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "the-life": false } },
  "installCommand": "(dnf install -y nspr nss atk at-spi2-atk cups-libs libdrm libXcomposite libXdamage libXrandr mesa-libgbm pango alsa-lib libxkbcommon at-spi2-core 2>/dev/null || true) && bun install && bun run --cwd apps/web-pwa browser",
  "buildCommand": "bun run --cwd apps/web-pwa build",
  "outputDirectory": "apps/web-pwa/dist",
  "framework": null,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/legal/terms",
      "destination": "/legal/terms-of-service",
      "statusCode": 301
    },
    {
      "source": "/legal/privacy",
      "destination": "/legal/privacy-policy",
      "statusCode": 301
    },
    {
      "source": "/legal/safety",
      "destination": "/legal/safety-and-content",
      "statusCode": 301
    },
    {
      "source": "/legal/refunds",
      "destination": "/legal/refund-and-cancellation",
      "statusCode": 301
    },
    {
      "source": "/legal/accessibility",
      "destination": "/legal/accessibility-statement",
      "statusCode": 301
    },
    {
      "source": "/legal/children",
      "destination": "/legal/childrens-privacy",
      "statusCode": 301
    },
    {
      "source": "/legal/consent",
      "destination": "/legal/parental-consent",
      "statusCode": 301
    },
    {
      "source": "/legal/community",
      "destination": "/legal/community-and-flags",
      "statusCode": 301
    },
    {
      "source": "/legal/use",
      "destination": "/legal/acceptable-use",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/db/:path*",
      "destination": "https://keepraxqagzgjrrweryt.supabase.co/:path*"
    },
    {
      "source": "/landing",
      "destination": "/app.html"
    },
    {
      "source": "/onboarding",
      "destination": "/app.html"
    },
    {
      "source": "/plans/checkout",
      "destination": "/app.html"
    },
    {
      "source": "/building",
      "destination": "/app.html"
    },
    {
      "source": "/chat",
      "destination": "/app.html"
    },
    {
      "source": "/learn",
      "destination": "/app.html"
    },
    {
      "source": "/practice",
      "destination": "/app.html"
    },
    {
      "source": "/progress",
      "destination": "/app.html"
    },
    {
      "source": "/you",
      "destination": "/app.html"
    },
    {
      "source": "/doubt",
      "destination": "/app.html"
    },
    {
      "source": "/parent/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/you/parent",
      "destination": "/app.html"
    },
    {
      "source": "/sandbox",
      "destination": "/app.html"
    },
    {
      "source": "/sitemap",
      "destination": "/app.html"
    },
    {
      "source": "/ui-kit",
      "destination": "/app.html"
    },
    {
      "source": "/subject/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/course/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/sandbox/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/concept/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/learn/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/subjects/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/glossary",
      "destination": "/app.html"
    },
    {
      "source": "/glossary/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/exams",
      "destination": "/app.html"
    },
    {
      "source": "/exams/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/compare",
      "destination": "/app.html"
    },
    {
      "source": "/compare/:path*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://api.heywobo.com https://*.googleusercontent.com https://*.razorpay.com; media-src 'self' data: blob: https://api.heywobo.com; worker-src 'self'; manifest-src 'self'; connect-src 'self' https://api.heywobo.com wss://api.heywobo.com https://heywobo.com https://cdn.jsdelivr.net https://api.razorpay.com https://lumberjack.razorpay.com https://lumberjack-cx.razorpay.com https://lumberjack-metrics.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self), payment=(self \"https://api.razorpay.com\")"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
